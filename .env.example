# ============ LLM（OpenAI 兼容接口，可自由切换厂商） ============
# 默认：智谱 GLM-4-Flash（完全免费、国内直连），https://open.bigmodel.cn 注册即得
DATAPILOT_LLM_PROVIDER=zhipu
DATAPILOT_LLM_API_KEY=
DATAPILOT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DATAPILOT_LLM_MODEL=glm-4-flash

# 对照实验用：SiliconFlow 免费 Qwen2.5-7B-Instruct，https://siliconflow.cn
DATAPILOT_LLM2_PROVIDER=siliconflow
DATAPILOT_LLM2_API_KEY=
DATAPILOT_LLM2_BASE_URL=https://api.siliconflow.cn/v1
DATAPILOT_LLM2_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============ Embedding（免费） ============
# SiliconFlow 免费 BGE-M3；无 key 时自动降级为本地 mock 向量（仅用于跑通链路）
DATAPILOT_EMBED_PROVIDER=siliconflow
DATAPILOT_EMBED_API_KEY=
DATAPILOT_EMBED_BASE_URL=https://api.siliconflow.cn/v1
DATAPILOT_EMBED_MODEL=BAAI/bge-m3

# ============ 数据库与检索 ============
DATAPILOT_DB_PATH=data/ecommerce.duckdb
DATAPILOT_RETRIEVAL_TOP_K=5
DATAPILOT_MAX_REPAIR_ROUNDS=3

# ============ 运行模式 ============
# 1 = 离线 mock 模式：无需任何 API Key 即可跑通全链路与单测
DATAPILOT_MOCK=0
